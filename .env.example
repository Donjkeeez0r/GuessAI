# Postgres
DB_USER=
DB_PASSWORD=
DB_NAME=

# Секрет подписи JWT — общий для REST и websocket
JWT_SECRET=

# Google Gemini: генерация паков
GEMINI_API_KEY=
# Токен бота: проверка подписи Telegram initData
TELEGRAM_BOT_TOKEN=

# Параметры игры
AI_QUESTIONS_PER_PACK=10
ROUND_DURATION_MS=15000
ROUND_REVEAL_MS=5000
ROOM_TTL_SECONDS=7200

# Порты на хосте
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Адрес API вшивается во фронтенд на этапе сборки, поэтому его тут нет:
# пусто = API берётся с origin фронта, nginx проксирует /api и /socket.io
# на бэкенд. Именно так фронт переживает смену адреса туннеля без
# пересборки. Заполнять только для доступа к бэкенду в обход прокси.
VITE_API_URL=

# Username бота без @ — из него строятся ссылки-приглашения
# t.me/<бот>?startapp=<код комнаты>. Пусто — ссылка выродится в адрес
# страницы и перестанет открываться как Mini App.
VITE_BOT_USERNAME=
