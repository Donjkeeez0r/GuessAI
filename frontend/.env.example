# Абсолютный адрес бэкенда. Оставьте пустым: тогда запросы идут на origin
# dev-сервера, а vite.config.ts проксирует их на бэкенд — как это делает nginx
# в контейнере. Заполнять только для обращения к бэкенду в обход прокси.
VITE_API_URL=

# Реальный initData, снятый из Telegram, для отладки в обычном браузере.
# Действует 24 часа. Копируй в .env.local — он в .gitignore.
VITE_DEV_INIT_DATA=

# Username бота для ссылок-приглашений: t.me/<bot>?startapp=<roomId>
VITE_BOT_USERNAME=
