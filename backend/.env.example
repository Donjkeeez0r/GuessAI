# Подключение к Postgres
DATABASE_URL=
# Подключение к Redis (в docker compose — redis://redis:6379)
REDIS_URL=

# Секрет подписи JWT. Общий для REST-гварда и сокет-гейтвея.
JWT_SECRET=

# Ключ Google Gemini для генерации паков
GEMINI_API_KEY=
# Токен бота, которым проверяется подпись Telegram initData
TELEGRAM_BOT_TOKEN=

# Сколько вопросов просить у модели на один AI-пак
AI_QUESTIONS_PER_PACK=10
# Длительность раунда, мс
ROUND_DURATION_MS=15000
# Показ правильного ответа между раундами, мс
ROUND_REVEAL_MS=5000
# TTL комнаты в Redis, секунды
ROOM_TTL_SECONDS=7200

# Порт HTTP-сервера
PORT=3000
